rules_version = '2';

// Regras do Cloud Firestore para o QualyControl.
// Qualquer usuário autenticado (Firebase Auth) pode ler e gravar os dados
// do painel (incidents, rework_entries, m2_imports e cadastros auxiliares).
// Usuários não logados não têm acesso.
//
// Para publicar: Console do Firebase > Firestore Database > Regras >
// cole este conteúdo e clique em "Publicar".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
